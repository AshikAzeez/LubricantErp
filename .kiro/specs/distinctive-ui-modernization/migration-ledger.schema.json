{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AshikAzeez/LubricantErp/.kiro/specs/distinctive-ui-modernization/migration-ledger.schema.json",
  "title": "Distinctive UI modernization migration ledger",
  "description": "Machine-validatable inventory for Requirements 16.1, 16.2, and 16.11-16.13.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "ledgerId",
    "requiredFamilies",
    "preservationConstraints",
    "surfaces"
  ],
  "properties": {
    "$schema": {
      "const": "./migration-ledger.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "ledgerId": {
      "const": "distinctive-ui-modernization"
    },
    "requiredFamilies": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "$ref": "#/$defs/family"
      },
      "allOf": [
        { "contains": { "const": "authentication" } },
        { "contains": { "const": "home" } },
        { "contains": { "const": "report-discovery" } },
        { "contains": { "const": "report-detail" } },
        { "contains": { "const": "customer" } },
        { "contains": { "const": "notification" } },
        { "contains": { "const": "payment" } },
        { "contains": { "const": "order" } },
        { "contains": { "const": "product" } },
        { "contains": { "const": "cost-breakdown" } },
        { "contains": { "const": "form" } },
        { "contains": { "const": "modal" } },
        { "contains": { "const": "navigation" } },
        { "contains": { "const": "settings" } }
      ]
    },
    "preservationConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeIdentifiersUnchanged",
        "permissionDecisionsUnchanged",
        "mviTypesUnchanged",
        "koinDefinitionsUnchanged",
        "coexistenceRequirements"
      ],
      "properties": {
        "routeIdentifiersUnchanged": { "const": true },
        "permissionDecisionsUnchanged": { "const": true },
        "mviTypesUnchanged": { "const": true },
        "koinDefinitionsUnchanged": { "const": true },
        "coexistenceRequirements": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "enum": ["16.11", "16.12", "16.13"]
          },
          "allOf": [
            { "contains": { "const": "16.11" } },
            { "contains": { "const": "16.12" } },
            { "contains": { "const": "16.13" } }
          ]
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      },
      "allOf": [
        { "contains": { "type": "object", "properties": { "family": { "const": "authentication" } }, "required": ["family"] } },
        { "contains": { "type": "object", "properties": { "family": { "const": "home" } }, "required": ["family"] } },
        { "contains": { "type": "object", "properties": { "family": { "const": "report-discovery" } }, "required": ["family"] } },
        { "contains": { "type": "object", "properties": { "family": { "const": "report-detail" } }, "required": ["family"] } },
        { "contains": { "type": "object", "properties": { "family": { "const": "customer" } }, "required": ["family"] } },
        { "contains": { "type": "object", "properties": { "family": { "const": "notification" } }, "required": ["family"] } },
        { "contains": { "type": "object", "properties": { "family": { "const": "payment" } }, "required": ["family"] } },
        { "contains": { "type": "object", "properties": { "family": { "const": "order" } }, "required": ["family"] } },
        { "contains": { "type": "object", "properties": { "family": { "const": "product" } }, "required": ["family"] } },
        { "contains": { "type": "object", "properties": { "family": { "const": "cost-breakdown" } }, "required": ["family"] } },
        { "contains": { "type": "object", "properties": { "family": { "const": "form" } }, "required": ["family"] } },
        { "contains": { "type": "object", "properties": { "family": { "const": "modal" } }, "required": ["family"] } },
        { "contains": { "type": "object", "properties": { "family": { "const": "navigation" } }, "required": ["family"] } },
        { "contains": { "type": "object", "properties": { "family": { "const": "settings" } }, "required": ["family"] } }
      ]
    }
  },
  "$defs": {
    "family": {
      "enum": [
        "authentication",
        "home",
        "report-discovery",
        "report-detail",
        "customer",
        "notification",
        "payment",
        "order",
        "product",
        "cost-breakdown",
        "form",
        "modal",
        "navigation",
        "settings"
      ]
    },
    "route": {
      "enum": [
        "gate",
        "login",
        "home",
        "settings",
        "report_detail/{reportKey}",
        "customer_data",
        "notifications",
        "report_module/{reportItemKey}",
        "payment_report",
        "orders",
        "proforma_invoices",
        "proforma_invoice_detail/{invoiceId}",
        "create_proforma_invoice?invoiceId={invoiceId}",
        "products",
        "cost_breakdown_detail/{id}",
        "create_cost_breakdown?sheetId={sheetId}"
      ]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "family",
        "surfaceType",
        "route",
        "surfaceSelector",
        "owner",
        "status",
        "deferralReason",
        "baselineCaseIds",
        "approvalIds",
        "releaseEvidenceIds",
        "sourceFiles"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "$ref": "#/$defs/family"
        },
        "surfaceType": {
          "enum": [
            "route",
            "route-mode",
            "tab",
            "report",
            "navigation-host",
            "navigation-chrome",
            "bottom-sheet",
            "dialog"
          ]
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "surfaceSelector": {
          "type": "string",
          "minLength": 1,
          "description": "Stable selector for a route mode, tab, report key, dialog, sheet, or navigation region."
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(?::[a-z0-9_]+)+(?:/[a-z0-9_]+)?$"
        },
        "status": {
          "enum": ["not started", "in progress", "complete", "deferred"]
        },
        "deferralReason": {
          "type": ["string", "null"]
        },
        "baselineCaseIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^BASE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
          }
        },
        "approvalIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^APR-(PRODUCT|BRAND)-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
          }
        },
        "releaseEvidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EVID-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
          }
        },
        "sourceFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(feature_reports/presentation|core/ui)/.+\\.kt$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "deferred" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "deferralReason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "else": {
            "properties": {
              "deferralReason": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
